    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.170.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
